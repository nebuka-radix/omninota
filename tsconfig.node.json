{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "src/renderer/src/features/workspace/latest-wins-saver.ts",
    "src/renderer/src/features/workspace/pane-layout.ts",
    "src/renderer/src/features/tasks/task-table.ts",
    "src/renderer/src/features/workspace/flush-request-handler.ts",
    "src/renderer/src/features/projects/project-order.ts",
    "src/renderer/src/features/projects/project-route.ts"
  ]
}
